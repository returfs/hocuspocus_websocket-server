{
  "name": "hocuspocus",
  "version": "1.0.0",
  "description": "Hocuspocus WebSocket server for Returfs real-time collaboration",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@hocuspocus/extension-database": "^2.0.0",
    "@hocuspocus/extension-logger": "^2.0.0",
    "@hocuspocus/extension-webhook": "^2.0.0",
    "@hocuspocus/server": "^2.0.0",
    "@hocuspocus/transformer": "^2.0.0",
    "@returfs/markdown-doc": "workspace:*",
    "@tiptap/extension-document": "2.7.2",
    "@tiptap/extension-paragraph": "2.7.2",
    "@tiptap/extension-text": "2.7.2",
    "@tiptap/html": "^2.8.0",
    "axios": "^1.20.0",
    "dotenv": "^17.4.2",
    "js-base64": "^3.9.3",
    "yjs": "^13.6.32"
  }
}
